-- 2. ขยาย Hitbox / ระยะตี
--------------------------------------------------------
_G.Hitbox = false
createButton("🥊 ขยาย Hitbox", function(state)
    _G.Hitbox = state
    if not state then
        for _, plr in pairs(game.Players:GetPlayers()) do
            if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                plr.Character.HumanoidRootPart.Size = Vector3.new(2, 2, 1)
                plr.Character.HumanoidRootPart.Transparency = 1
            end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(0.5)
        if _G.Hitbox then
            for _, plr in pairs(game.Players:GetPlayers()) do
                if plr ~= game.Players.LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                    local hrp = plr.Character.HumanoidRootPart
                    hrp.Size = Vector3.new(15, 15, 15) -- ขยายขนาดกล่องรับดาเมจ
                    hrp.Transparency = 0.7
                    hrp.BrickColor = BrickColor.new("Really red")
                    hrp.Material = Enum.Material.Neon
                    hrp.CanCollide = false
                end
            end
        end
    end
end)

--------------------------------------------------------
-- 3. เส้นวาดบอกตำแหน่ง (ESP Line)
--------------------------------------------------------
_G.ESPLine = false
createButton("📏 มองเส้น (ESP Line)", function(state)
    _G.ESPLine = state
end)

game:GetService("RunService").RenderStepped:Connect(function()
    if _G.ESPLine then
        for _, plr in pairs(game.Players:GetPlayers()) do
            if plr ~= game.Players.LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = plr.Character.HumanoidRootPart
                if not hrp:FindFirstChild("ESP_Box") then
                    local highlight = Instance.new("Highlight")
                    highlight.Name = "ESP_Box"
                    highlight.Parent = plr.Character
                    highlight.FillColor = Color3.fromRGB(255, 0, 0)
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                end
            end
        end
    else
        for _, plr in pairs(game.Players:GetPlayers()) do
            if plr.Character and plr.Character:FindFirstChild("ESP_Box") then
                plr.Character.ESP_Box:Destroy()
            end
        end
    end
end)

--------------------------------------------------------
-- 4. ออโต้ฟาร์ม (Auto Farm)
--------------------------------------------------------
_G.AutoFarm = false
createButton("🌾 ออโต้ฟาร์ม (Auto Farm)", function(state)
    _G.AutoFarm = state
end)

task.spawn(function()
    while true do
        task.wait(0.1)
        if _G.AutoFarm then
            local p = game.Players.LocalPlayer
            if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                for _, target in pairs(workspace:GetChildren()) do
                    if target:FindFirstChild("Humanoid") and target.Humanoid.Health > 0 and target ~= p.Character then
                        if target:FindFirstChild("HumanoidRootPart") then
                            p.Character.HumanoidRootPart.CFrame = target.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
                            break
                        end
                    end
                end
            end
        end
    end
end)
